        "operation": "executeQuery",
        "query": "BEGIN;\nDO $$\nBEGIN\n  EXECUTE format(\n    'ALTER TABLE _rag_real_estate_mistral_1024_db RENAME TO %I',\n    '_archive_rag_real_estate_mistral_1024_db_' || to_char(current_timestamp, 'YYYYMMDD_HH24MI')\n  );\nEND;\n$$;\n\nALTER TABLE _rag_real_estate_mistral_1024_db_swap RENAME TO _rag_real_estate_mistral_1024_db;\nCREATE TABLE _rag_real_estate_mistral_1024_db_swap (\n    id SERIAL PRIMARY KEY,\n    text TEXT NOT NULL,\n    metadata JSONB,\n    created_at TIMESTAMP DEFAULT NOW(),\n    embedding VECTOR(1024)\n);\nCOMMIT;\n\n-- 1. Enable Row Level Security\nALTER TABLE _rag_real_estate_mistral_1024_db_swap ENABLE ROW LEVEL SECURITY;\n\n-- 2. Create a policy to allow anyone to read the embeddings (Public Read)\nCREATE POLICY \"Allow public read access\" \nON _rag_real_estate_mistral_1024_db_swap \nFOR SELECT \nUSING (true);\n\n-- 3. Create a policy to allow only authenticated users to insert/update data\nCREATE POLICY \"Allow authenticated inserts\" \nON _rag_real_estate_mistral_1024_db_swap \nFOR INSERT \nTO authenticated \nWITH CHECK (true);",
